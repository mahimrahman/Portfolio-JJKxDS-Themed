# Cloudinary config (DO NOT commit real secrets in .env files)
# Option A (recommended): authenticated uploads
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@dacbxyltq

# Option B: key/secret as separate vars
# CLOUDINARY_CLOUD_NAME=dacbxyltq
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Option C (no secrets): unsigned upload preset
# Create an unsigned upload preset in Cloudinary Dashboard first
# CLOUDINARY_CLOUD_NAME=dacbxyltq
# CLOUDINARY_UPLOAD_PRESET=
